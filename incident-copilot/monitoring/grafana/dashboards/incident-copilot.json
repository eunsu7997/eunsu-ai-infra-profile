{
  "title": "AI Incident Copilot",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "type": "stat",
      "title": "Analyses / 5m",
      "targets": [
        {
          "expr": "sum(increase(incident_analyses_total[5m]))"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Analysis rate by severity",
      "targets": [
        {
          "expr": "sum by (severity) (rate(incident_analyses_total[1m]))",
          "legendFormat": "{{severity}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "p95 analysis latency",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(incident_analysis_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      }
    }
  ]
}